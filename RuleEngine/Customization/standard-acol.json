      "matchSuffix": true,
      "alert": true,
      "meaning": "D0P1 after interference: pass shows one ace.",
      "priority": 1100,
      "facts": {
        "slam": {
          "aceAsk": {
            "active": true,
            "method": "blackwood",
            "interference": "D0P1"
          },
